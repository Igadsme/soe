# Copy to .env. All credentials below are placeholders; replace before production.
# Required in production: PostgreSQL connection (URL-encode password characters).
SOE_DATABASE_URL=postgresql+psycopg://soe:replace-with-database-password@db:5432/soe
# Required in production: production and false; staging uses the same security checks.
SOE_ENV=production
SOE_DEMO_MODE=false
# Required in production: random session signing secret, at least 32 characters.
SOE_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
# Admin login name. Required in production: password hash only.
SOE_ADMIN_USERNAME=operator
# Plaintext password login is supported only in development; use a hash in production.
SOE_ADMIN_PASSWORD=
# Generate with app.auth.make_password_hash; quote hashes in .env to preserve '$'.
SOE_ADMIN_PASSWORD_HASH='replace-with-generated-password-hash'
# Session lifetime in seconds.
SOE_SESSION_TTL_SECONDS=28800
# Required in production: comma-separated exact browser origins, no wildcard.
SOE_CORS_ORIGINS=https://app.example.com
# Local media directory; production Compose sets /app/media on a shared named volume.
SOE_MEDIA_ROOT=./media
# Maximum upload bytes and clip duration in seconds.
SOE_MAX_UPLOAD_BYTES=2000000000
SOE_MAX_CLIP_SECONDS=180
# Must remain false; production/staging startup rejects true.
SOE_PUBLISHING_ENABLED=false
# Whisper model to download/use for transcription.
SOE_WHISPER_MODEL_SIZE=tiny.en
# Optional official discovery credentials; required for the corresponding live provider.
SOE_YOUTUBE_API_KEY=
SOE_TWITCH_CLIENT_ID=
SOE_TWITCH_CLIENT_SECRET=
# Comma-separated trusted proxy IPs/CIDRs; empty ignores X-Forwarded-For.
SOE_TRUSTED_PROXIES=
# Required in production: shared Redis rate-limit backend; empty uses memory in development.
SOE_REDIS_URL=redis://redis:6379/0
# Requests per client IP per minute.
SOE_RATE_LIMIT_PER_MINUTE=120

# Required by production Compose: PostgreSQL initialization credentials/database.
POSTGRES_USER=soe
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DB=soe
# API entrypoint migration toggle (default true outside production Compose).
# Keep false for replicated services; run a single migration command before starting.
SOE_RUN_MIGRATIONS=false
# Gunicorn processes per API container; API listening port outside Compose.
SOE_WEB_CONCURRENCY=2
PORT=8000
# Required for production frontend build: public browser-visible API URL, baked into JS.
# Recommended: same browser origin; reverse-proxy /api to the API service.
NEXT_PUBLIC_API_URL=https://app.example.com
# Production Compose image tag and host bindings; only API/frontend publish ports.
SOE_IMAGE_TAG=local
SOE_BIND_ADDRESS=127.0.0.1
SOE_API_PORT=8000
SOE_FRONTEND_PORT=3000
# Optional test-only switch: downloads a model and performs real media integration tests.
SOE_RUN_MEDIA_E2E=0

# Explicit opt-in; only development, loopback clients, and no configured credentials.
SOE_DEV_AUTH_BYPASS=false
# Session idle expiry and cleanup retention (seconds).
SOE_SESSION_IDLE_SECONDS=1800
SOE_SESSION_RETENTION_SECONDS=604800
# Bound each FFmpeg/ffprobe subprocess and total source duration.
SOE_FFMPEG_TIMEOUT_SECONDS=300
SOE_MAX_SOURCE_SECONDS=3600
# Production API and worker share the soe-whisper volume at this path.
SOE_WHISPER_CACHE_DIR=/app/.cache/whisper
# Optional integration-test services (never production credentials).
SOE_TEST_REDIS_URL=
SOE_TEST_POSTGRES_URL=
